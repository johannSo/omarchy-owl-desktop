#!/usr/bin/env bash

# owl-desktop: Omalauncher's OWL widgets on the Omarchy desktop.
#
#   owl-desktop start                  show the widgets (in the background; does nothing when they show)
#   owl-desktop stop | restart         take them off the desktop, or start them again
#   owl-desktop status                 whether it's running, and where everything is
#   owl-desktop arrange [<file>]       arrange the desktop, as holding a widget does (done, toggle)
#   owl-desktop list                   the widgets: where they are, and what's wrong with them
#   owl-desktop screen <file>          open a widget's screen { }
#   owl-desktop reload                 read the folder, the style and every widget again
#   owl-desktop style                  edit ~/.config/owl-desktop/style.toml
#   owl-desktop logs                   what the desktop has logged
#   owl-desktop autostart [on|off]     start with Hyprland (~/.config/hypr/autostart.lua)
#   owl-desktop link                   put owl-desktop on your PATH (~/.local/bin)
#
# The store and your agent, as Omalauncher's desktop app has them:
#
#   owl-desktop install <author/name>  install a reviewed widget from the store
#   owl-desktop remove <author/name>   remove one installed from the store
#   owl-desktop packages <file>        install the packages a widget requires
#   owl-desktop new                    create a widget with your agent
#   owl-desktop edit <file>            change a widget with your agent
#   owl-desktop share <file>           the widget as a link and a QR code for the phone
#   owl-desktop import <link>          add a widget someone shared
#   owl-desktop publish <file>         your agent opens a pull request to the store
#   owl-desktop check <file>           your agent looks for anything personal in it
#
# A <file> is a path, or a name in the widget folder (~/.config/omarchy-widgets).
# Exit 0 done, 1 failed, 2 usage.

set -euo pipefail

me=owl-desktop
APP=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/owl-desktop
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/owl-desktop
STYLE=$CONFIG/style.toml
AUTOSTART=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/autostart.lua

die() { echo "$me: $*" >&2; exit 1; }
usage() { sed -n '5,30p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed${2:+ ($2)}"; }
tilde() { [[ $1 == "$HOME"* ]] && echo "~${1#"$HOME"}" || echo "$1"; }

# The widget folder: $OWL_WIDGETS, style.toml's folder, or Omalauncher's.
folder() {
  local d=${OWL_WIDGETS:-}
  if [[ -z $d && -f $STYLE ]]; then
    d=$(sed -n 's/^[[:space:]]*folder[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$STYLE" | head -1)
  fi
  d=${d:-~/.config/omarchy-widgets}
  [[ $d == "~" || $d == "~/"* ]] && d=$HOME${d:1}
  echo "${d%/}"
}
DIR=$(folder)

running() { quickshell list -p "$APP" 2>/dev/null | grep -q "^Instance"; }

ipc() {
  running || die "the desktop widgets aren't running: owl-desktop start"
  quickshell ipc -p "$APP" call owl-desktop "$@"
}

# A file as the desktop knows it: relative to the widget folder.
relative() {
  local f=$1
  [[ -e $f ]] && f=$(readlink -f -- "$f")
  if [[ $f == "$DIR"/* ]]; then echo "${f#"$DIR"/}"; return; fi
  [[ $f == /* ]] && die "$(tilde "$f") isn't in the widget folder, $(tilde "$DIR")"
  [[ -e $DIR/$f ]] && { echo "$f"; return; }
  [[ -e $DIR/$f.owl ]] && { echo "$f.owl"; return; }
  die "no widget $f in $(tilde "$DIR")"
}

# A file as omarchy-widgets wants it: a path.
absolute() {
  local f=$1
  [[ -e $f ]] && { readlink -f -- "$f"; return; }
  echo "$DIR/$(relative "$f")"
}

widgets() { OWL_WIDGETS=$DIR OMARCHY_WIDGETS_APP=$APP exec "$APP/bin/omarchy-widgets" "$@"; }

cmd_run() {
  need quickshell "pacman -S quickshell"
  exec quickshell -n -p "$APP"
}

cmd_start() {
  need quickshell "pacman -S quickshell"
  if running; then echo "the desktop widgets are running"; return 0; fi
  mkdir -p "$STATE"
  if command -v uwsm-app >/dev/null 2>&1 && [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    setsid -f uwsm-app -- "$APP/bin/owl-desktop" run >/dev/null 2>&1 </dev/null
  else
    setsid -f quickshell -n -p "$APP" >/dev/null 2>&1 </dev/null
  fi
  local i
  for i in $(seq 1 50); do
    running && { echo "the desktop widgets are running: $(tilde "$DIR")"; return 0; }
    sleep 0.1
  done
  die "it didn't start; owl-desktop logs says why"
}

cmd_stop() {
  running || { echo "the desktop widgets aren't running"; return 0; }
  quickshell kill -p "$APP" >/dev/null
  echo "stopped"
}

cmd_status() {
  if running; then echo "running"; else echo "not running"; fi
  echo "widgets:   $(tilde "$DIR")"
  echo "style:     $(tilde "$STYLE")"
  echo "layout:    $(tilde "$STATE/layout.json")"
  echo "runtime:   $(tilde "$APP/owl") ($(sed -n 's/^runtimes\/quickshell //p' "$APP/owl/VERSION"))"
  if grep -qs 'owl-desktop' "$AUTOSTART"; then echo "autostart: on"; else echo "autostart: off (owl-desktop autostart on)"; fi
  command -v inotifywait >/dev/null 2>&1 || echo "note: without inotify-tools, new files show within two seconds instead of at once"
}

cmd_autostart() {
  local want=${1:-on}
  [[ $want == on || $want == off ]] || usage
  local line="o.launch_on_start(\"$APP/bin/owl-desktop run\")"
  if [[ $want == on ]]; then
    grep -qsF "$line" "$AUTOSTART" && { echo "already starts with Hyprland ($(tilde "$AUTOSTART"))"; return 0; }
    mkdir -p "$(dirname "$AUTOSTART")"
    [[ -f $AUTOSTART ]] && cp "$AUTOSTART" "$AUTOSTART.bak.$(date +%s)"
    # An older install somewhere else: start this one instead.
    sed -i '/OWL widgets on the desktop (owl-desktop autostart off removes this)/d; /owl-desktop/d' "$AUTOSTART" 2>/dev/null || true
    printf '\n-- OWL widgets on the desktop (owl-desktop autostart off removes this).\n%s\n' "$line" >>"$AUTOSTART"
    echo "starts with Hyprland from now on ($(tilde "$AUTOSTART"))"
  else
    grep -qs 'owl-desktop' "$AUTOSTART" || { echo "doesn't start with Hyprland"; return 0; }
    cp "$AUTOSTART" "$AUTOSTART.bak.$(date +%s)"
    sed -i '/OWL widgets on the desktop (owl-desktop autostart off removes this)/d; /owl-desktop/d' "$AUTOSTART"
    echo "no longer starts with Hyprland"
  fi
  command -v hyprctl >/dev/null 2>&1 && hyprctl configerrors 2>/dev/null | grep -v '^$' | grep -iv 'no errors' >&2 || true
}

cmd_link() {
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$APP/bin/owl-desktop" "$HOME/.local/bin/owl-desktop"
  echo "linked ~/.local/bin/owl-desktop"
}

cmd=${1:-start}
(($#)) && shift
case $cmd in
  run) cmd_run ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  arrange)
    f=""
    if (($#)); then f=$(relative "$1"); fi
    ipc arrange "$f" ;;
  done) ipc done ;;
  toggle) ipc toggle ;;
  list) ipc list ;;
  reload) ipc reload ;;
  screen)
    (($# == 1)) || usage
    f=$(relative "$1")
    ipc screen "$f" ;;
  style)
    mkdir -p "$CONFIG"
    if running; then ipc style; else exec "${VISUAL:-${EDITOR:-xdg-open}}" "$STYLE"; fi ;;
  logs) need quickshell; quickshell log -p "$APP" "$@" ;;
  autostart) cmd_autostart "$@" ;;
  link) cmd_link ;;
  folder) echo "$DIR" ;;
  install | remove | new | import | starter) widgets "$cmd" "$@" ;;
  packages | edit | share | publish | check)
    args=()
    for a in "$@"; do if [[ $a == -* ]]; then args+=("$a"); else args+=("$(absolute "$a")"); fi; done
    widgets "$cmd" "${args[@]}" ;;
  -h | --help | help) usage ;;
  *) usage ;;
esac
