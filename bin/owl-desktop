#!/usr/bin/env bash

# owl-desktop: OmaLauncher++ Desktop, OWL widgets on the Omarchy desktop.
# The widgets are drawn by the Omarchy shell, which loads this plugin.
#
#   owl-desktop enable | disable       show the widgets, or take them off the desktop (start, stop)
#   owl-desktop status                 whether the plugin is enabled, and where everything is
#   owl-desktop arrange [<file>]       arrange the desktop, as holding a widget does (done, toggle)
#   owl-desktop list                   the widgets: where they are, and what's wrong with them
#   owl-desktop screen <file>          open a widget's screen { }
#   owl-desktop store [<author/name>]  the store, or the page of a widget or face in it
#   owl-desktop look <file> [--opacity <0-1>|--opacity style] [--border on|off]
#                                      one widget's own look, over the style's
#   owl-desktop reload                 read the folder, the style and every widget again
#   owl-desktop style                  edit ~/.config/owl-desktop/style.toml
#   owl-desktop logs                   what the Omarchy shell has logged
#   owl-desktop link                   put owl-desktop on your PATH (~/.local/bin)
#   owl-desktop update                 update the plugin (omarchy plugin update)
#   owl-desktop migrate                stop the standalone owl-desktop 1.x and take it out of Hyprland's autostart
#
# The store and your agent, as Omalauncher's desktop app has them:
#
#   owl-desktop install <author/name>  install a reviewed widget from the store
#   owl-desktop remove <author/name>   remove one installed from the store
#   owl-desktop packages <file>        install the packages a widget requires
#   owl-desktop new                    create a widget with your agent
#   owl-desktop edit <file>            change a widget with your agent
#   owl-desktop share <file>           the widget as a link and a QR code for the phone
#   owl-desktop import <link>          add a widget someone shared
#   owl-desktop publish <file>         your agent opens a pull request to the store
#   owl-desktop check <file>           your agent looks for anything personal in it
#
# A <file> is a path, or a name in the widget folder (~/.config/omarchy-widgets).
# Exit 0 done, 1 failed, 2 usage.

set -euo pipefail

me=owl-desktop
ID=io.github.johannso.owl-desktop
TARGET=owl-desktop
APP=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/owl-desktop
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/owl-desktop
STYLE=$CONFIG/style.toml
AUTOSTART=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/autostart.lua
export OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}

die() { echo "$me: $*" >&2; exit 1; }
usage() { sed -n '3,34p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed${2:+ ($2)}"; }
tilde() { [[ $1 == "$HOME"* ]] && echo "~${1#"$HOME"}" || echo "$1"; }

# The widget folder: $OWL_WIDGETS, style.toml's folder, or Omalauncher's.
folder() {
  local d=${OWL_WIDGETS:-}
  if [[ -z $d && -f $STYLE ]]; then
    d=$(sed -n 's/^[[:space:]]*folder[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$STYLE" | head -1)
  fi
  d=${d:-~/.config/omarchy-widgets}
  # A literal ~ (style.toml's folder, or the default) is your home.
  # shellcheck disable=SC2088
  [[ $d == "~" || $d == "~/"* ]] && d=$HOME${d:1}
  echo "${d%/}"
}
DIR=$(folder)

# The plugin answers once the shell has loaded it.
running() { command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell "$TARGET" status >/dev/null 2>&1; }

ipc() {
  need omarchy-shell "the Omarchy shell, Omarchy 4.5 or newer"
  running || die "the plugin isn't loaded: owl-desktop enable"
  omarchy-shell "$TARGET" "$@"
}

# A file as the desktop knows it: relative to the widget folder.
relative() {
  local f=$1
  [[ -e $f ]] && f=$(readlink -f -- "$f")
  if [[ $f == "$DIR"/* ]]; then echo "${f#"$DIR"/}"; return; fi
  [[ $f == /* ]] && die "$(tilde "$f") isn't in the widget folder, $(tilde "$DIR")"
  [[ -e $DIR/$f ]] && { echo "$f"; return; }
  [[ -e $DIR/$f.owl ]] && { echo "$f.owl"; return; }
  die "no widget $f in $(tilde "$DIR")"
}

# A file as omarchy-widgets wants it: a path.
absolute() {
  local f=$1
  [[ -e $f ]] && { readlink -f -- "$f"; return; }
  echo "$DIR/$(relative "$f")"
}

widgets() { OWL_WIDGETS=$DIR OMARCHY_WIDGETS_APP=$APP exec "$APP/bin/omarchy-widgets" "$@"; }

cmd_enable() {
  need omarchy "Omarchy 4.5 or newer"
  omarchy plugin enable "$ID"
  local _
  for _ in $(seq 1 50); do
    running && { echo "the desktop widgets are showing: $(tilde "$DIR")"; return 0; }
    sleep 0.1
  done
  die "the shell didn't load the plugin; owl-desktop logs says why"
}

cmd_disable() {
  need omarchy "Omarchy 4.5 or newer"
  omarchy plugin disable "$ID"
  echo "the desktop widgets are off; your widgets, style and layout stay"
}

cmd_status() {
  local info=""
  if running; then
    info=$(omarchy-shell "$TARGET" status)
    echo "enabled (version $(jq -r '.version' <<<"$info"), $(jq -r '.widgets' <<<"$info") widgets)"
  else
    echo "not loaded (owl-desktop enable)"
  fi
  echo "widgets:   $(tilde "$DIR")"
  echo "style:     $(tilde "$STYLE")"
  echo "layout:    $(tilde "$STATE/layout.json")"
  echo "plugin:    $(tilde "$APP")"
  echo "runtime:   $(tilde "$APP/owl") ($(sed -n 's/^runtimes\/quickshell //p' "$APP/owl/VERSION"))"
  command -v inotifywait >/dev/null 2>&1 || echo "note: without inotify-tools, new files show within two seconds instead of at once"
  if grep -qs 'owl-desktop' "$AUTOSTART"; then echo "note: the standalone owl-desktop 1.x is still in $(tilde "$AUTOSTART"); owl-desktop migrate takes it out"; fi
}

# owl-desktop 1.x was a Quickshell instance of its own, started by a line in
# Hyprland's autostart. The plugin replaces both; this asks before it changes
# autostart.lua, and keeps a copy.
cmd_migrate() {
  local found=0 path
  if command -v quickshell >/dev/null 2>&1; then
    while IFS= read -r path; do
      # Only a Quickshell instance run from an owl-desktop checkout: never the Omarchy shell.
      [[ -n $path && -f $path/bin/owl-desktop ]] || continue
      found=1
      quickshell kill -p "$path" >/dev/null 2>&1 && echo "stopped the standalone widgets ($(tilde "$path"))"
    done < <(pgrep -a quickshell | sed -n 's/.* -p \([^ ]*\).*/\1/p' | sort -u)
  fi
  if grep -qs 'owl-desktop' "$AUTOSTART"; then
    found=1
    local answer=y
    if [[ ${1:-} != --yes ]]; then
      read -r -p "Remove owl-desktop's lines from $(tilde "$AUTOSTART")? A copy is kept. [y/N] " answer || answer=n
    fi
    if [[ $answer == [yY]* ]]; then
      cp "$AUTOSTART" "$AUTOSTART.bak.$(date +%s)"
      sed -i '/OWL widgets on the desktop (owl-desktop autostart off removes this)/d; /owl-desktop/d' "$AUTOSTART"
      echo "no longer starts with Hyprland on its own; the Omarchy shell loads the plugin"
    else
      echo "left $(tilde "$AUTOSTART") as it is"
    fi
  fi
  ((found)) || echo "nothing of owl-desktop 1.x is left"
}

cmd_link() {
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$APP/bin/owl-desktop" "$HOME/.local/bin/owl-desktop"
  echo "linked ~/.local/bin/owl-desktop"
}

cmd_look() {
  (($# >= 1)) || usage
  local f opacity border current
  f=$(relative "$1")
  shift
  current=$(ipc list | jq -c --arg f "$f" '.[] | select(.file == $f) | .cell // {}' | head -1)
  [[ -n $current ]] || die "$f isn't on the desktop"
  opacity=$(jq -r '.opacity // ""' <<<"$current")
  border=$(jq -r 'if .border == false then "off" else "on" end' <<<"$current")
  while (($#)); do
    case $1 in
      --opacity) [[ -n ${2:-} ]] || usage; opacity=$2; [[ $opacity == style ]] && opacity=""; shift 2 ;;
      --border) [[ ${2:-} == on || ${2:-} == off ]] || usage; border=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  local answer
  answer=$(ipc look "$f" "$opacity" "$border")
  [[ $answer == ok ]] || die "$answer"
  echo "ok"
}

cmd=${1:-status}
(($#)) && shift
case $cmd in
  enable | start) cmd_enable ;;
  disable | stop) cmd_disable ;;
  restart) cmd_disable >/dev/null; cmd_enable ;;
  status) cmd_status ;;
  arrange)
    f=""
    if (($#)); then f=$(relative "$1"); fi
    ipc arrange "$f" ;;
  "done") ipc "done" ;;
  toggle) ipc toggle ;;
  list) ipc list ;;
  reload) ipc reload ;;
  screen)
    (($# == 1)) || usage
    f=$(relative "$1")
    ipc screen "$f" ;;
  store)
    (($# <= 1)) || usage
    ipc store "${1:-}" ;;
  look) cmd_look "$@" ;;
  style)
    mkdir -p "$CONFIG"
    if running; then ipc style; else exec "${VISUAL:-${EDITOR:-xdg-open}}" "$STYLE"; fi ;;
  logs) need qs "quickshell"; qs log -p "$OMARCHY_PATH/shell" "$@" ;;
  link) cmd_link ;;
  update) need omarchy "Omarchy 4.5 or newer"; exec omarchy plugin update "$ID" "$@" ;;
  migrate) cmd_migrate "$@" ;;
  folder) echo "$DIR" ;;
  install | remove | new | import | starter) widgets "$cmd" "$@" ;;
  packages | edit | share | publish | check)
    args=()
    for a in "$@"; do if [[ $a == -* ]]; then args+=("$a"); else args+=("$(absolute "$a")"); fi; done
    widgets "$cmd" "${args[@]}" ;;
  -h | --help | help) usage ;;
  *) usage ;;
esac
